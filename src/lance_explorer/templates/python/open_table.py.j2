{% include "_connection.py.j2" %}

table_path = UPath({{ table_uri | pyrepr }})
db = lancedb.connect(str(table_path.parent), storage_options=storage_options or None)
open_version = {{ open_version | default(none) | pyrepr }}  # None keeps the latest version.
table = db.open_table(table_path.name.removesuffix(".lance"))
if open_version is not None:
    table.checkout(open_version)
