{% include "open_table.py.j2" %}

query = table.search(
    {{ text | pyrepr }},
    query_type="fts",
    fts_columns={{ column | pyrepr }},
)
{% if where %}query = query.where({{ where | pyrepr }})
{% endif %}rows = query.limit({{ limit }}).to_pandas()
{% if columns %}selected_columns = {{ columns | pyrepr }}
rows = rows[[column for column in [*selected_columns, "_score"] if column in rows.columns]]
{% endif %}
