import os

import lancedb
from upath import UPath

# AWS credentials are resolved by the normal environment/provider chain.
# Optional S3-compatible settings remain placeholders and never include values.
storage_options = {
    "endpoint": os.getenv("AWS_ENDPOINT", ""),
    "region": os.getenv("AWS_DEFAULT_REGION", ""),
    "allow_http": os.getenv("ALLOW_HTTP", "false"),
}
storage_options = {key: value for key, value in storage_options.items() if value}
